NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taakra:taakra-local@127.0.0.1:5432/taakra
# Generate a private value with: openssl rand -hex 32
APP_SECRET=
# Optional public footer information. Leave blank to hide it.
ORGANIZER_NAME=
ORGANIZER_EMAIL=
# Set to the approved number of days. A positive value is required.
RETENTION_DAYS=
# Production example: PUBLIC_ORIGIN=https://registration.example.org
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set GOOGLE_AUTH_MODE to oauth or service-account to enable Google sync.
GOOGLE_AUTH_MODE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Prefer a mounted private file for OAuth. GOOGLE_REFRESH_TOKEN is also supported.
GOOGLE_REFRESH_TOKEN_FILE=
# Service account: mount credentials here, or use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PARENT_FOLDER_ID=
GOOGLE_SPREADSHEET_ID=
# Comma-separated organizer, service account and explicitly authorized staff principals.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ROW_LIMIT=20000
