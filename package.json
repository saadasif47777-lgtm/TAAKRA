{
  "name": "taakra-registration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && node scripts/build-web.mjs && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "start:deploy": "node --env-file-if-exists=.env dist-server/index.js --migrate",
    "db:migrate": "tsx --env-file-if-exists=.env server/migrate.ts",
    "google:setup": "tsx --env-file-if-exists=.env server/google-setup.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-turnstile": "^1.1.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
